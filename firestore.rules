rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isApprovedTeacher() {
      return isAuthenticated() && 
             getUserData().role == 'teacher' && 
             getUserData().approved == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNotChangingPrivilegedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved']);
    }

    // Collection 1: users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && isNotChangingPrivilegedUserFields());
      allow delete: if isAdmin();
    }

    // Collection 2: projects
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // Collection 3: reviews
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if (isApprovedTeacher() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update: if (isApprovedTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Collection 4: sihDomains
    match /sihDomains/{domainId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
